{
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "name": "react-native-web",
  "version": "0.21.4",
  "description": "React Native for Web",
  "type": "module",
  "main": "dist/index.js",
  "types": "types/react-native-web.d.ts",
  "exports": {
    ".": {
      "types": "./types/react-native-web.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./types/index.d.ts"
    },
    "./asset-registry": "./dist/exports/AssetRegistry/index.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "types",
    "!**/__tests__"
  ],
  "scripts": {
    "clean": "del-cli ./dist",
    "build": "npm run clean && babel src --root-mode upward --out-dir dist --ignore \"**/__tests__\"",
    "dev": "npm run clean && babel src --root-mode upward --out-dir dist --ignore \"**/__tests__\" --watch"
  },
  "dependencies": {
    "@react-native/normalize-colors": "^0.88.0",
    "invariant": "^2.2.4",
    "memoize-one": "^6.0.0",
    "nullthrows": "^1.1.1",
    "postcss-value-parser": "^4.2.0",
    "styleq": "^0.1.3"
  },
  "devDependencies": {
    "del-cli": "^8.0.1"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "author": "Nicolas Gallagher",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/necolas/react-native-web.git"
  },
  "tags": [
    "react"
  ],
  "keywords": [
    "react",
    "react-component",
    "react-native",
    "web"
  ]
}
