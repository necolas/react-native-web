{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "name": "react-ui-monorepo",
  "scripts": {
    "clean": "del-cli ./packages/*/dist",
    "build": "npm run clean && npm run build --workspaces --if-present",
    "compile": "npm run build",
    "dev": "npm run dev --workspaces --if-present",
    "flow": "flow",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "module-map": "node ./scripts/createModuleMap.js --write",
    "prerelease": "npm run test && npm run build",
    "release": "node ./scripts/releasePackages.js",
    "release:benchmarks": "git checkout gh-pages && rm -rf ./docs/benchmarks && mv packages/benchmarks/dist ./docs/benchmarks && git add -A && git commit -m \"Deploy benchmarks\" && git push origin gh-pages && git checkout -",
    "release:react-native-web-docs": "git checkout gh-pages && rm -rf ./docs && mv packages/react-native-web-docs/dist ./docs && git add ./docs && git commit -m \"Deploy documentation\" && git push origin gh-pages && git checkout -",
    "postrelease": "npm run release:react-native-web-docs && npm run release:benchmarks",
    "prepare": "husky",
    "test": "npm run flow && npm run format && npm run lint && npm run unit -- --runInBand",
    "unit": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "unit:dom": "npm run unit -- --selectProjects dom",
    "unit:node": "npm run unit -- --selectProjects node"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "core-js": false,
    "fsevents": false,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/react": "^16.3.3",
    "babel-jest": "^30.5.2",
    "babel-plugin-fully-specified": "^1.3.1",
    "babel-plugin-syntax-hermes-parser": "0.37.0",
    "cross-env": "^10.1.0",
    "del-cli": "^8.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "flow-bin": "0.336.0",
    "hermes-eslint": "0.37.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-hermes-parser": "0.37.0"
  },
  "workspaces": [
    "packages/react-native-web",
    "packages/*"
  ],
  "lint-staged": {
    "packages/react-native-web/src/{index.js,exports/*/index.js}": [
      "node ./scripts/createModuleMap.js"
    ],
    "**/*.js": [
      "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
      "eslint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "plugins": [
      "prettier-plugin-hermes-parser"
    ],
    "overrides": [
      {
        "files": [
          "*.js",
          "*.jsx",
          "*.flow"
        ],
        "options": {
          "parser": "hermes"
        }
      }
    ]
  },
  "author": "Nicolas Gallagher",
  "license": "MIT"
}
