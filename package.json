{
  "name": "react-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Nicolas Gallagher",
  "workspaces": [
    "packages/react-native-web",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "clean": "del-cli ./packages/*/dist",
    "build": "npm run clean && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "module-map": "node ./scripts/createModuleMap.js --write",
    "release": "node ./scripts/releasePackages.js",
    "release:benchmarks": "git checkout gh-pages && rm -rf ./docs/benchmarks && mv packages/benchmarks/dist ./docs/benchmarks && git add -A && git commit -m \"Deploy benchmarks\" && git push origin gh-pages && git checkout -",
    "release:react-native-web-docs": "git checkout gh-pages && rm -rf ./docs && mv packages/react-native-web-docs/dist ./docs && git add ./docs && git commit -m \"Deploy documentation\" && git push origin gh-pages && git checkout -",
    "prepare": "husky",
    "typecheck": "tsc -b",
    "test": "npm run typecheck && npm run format && npm run lint && npm run unit",
    "unit": "vitest run",
    "unit:dom": "vitest run --project dom",
    "unit:node": "vitest run --project node"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-fully-specified": "^1.3.1",
    "del-cli": "^8.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "packages/react-native-web/src/{index.ts,exports/*/index.{ts,tsx}}": [
      "node ./scripts/createModuleMap.js"
    ],
    "**/*.{js,ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "allowScripts": {
    "core-js": false,
    "fsevents": false
  }
}
